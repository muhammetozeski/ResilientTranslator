@inherits CoreElement
@if (IsGrouped && !Multiline)
{
    <div class="core-input-group" style="@GroupStyle">
        @if (!string.IsNullOrEmpty(Icon)) { <span class="core-input-icon">@Icon</span> }
        @NativeInput()
        @ChildContent
    </div>
}
else { @NativeInput() }
<CoreInputCss />
@code {
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string Placeholder { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string CustomClass { get; set; } = "";
    [Parameter] public bool IsRequired { get; set; }
    [Parameter] public bool IsGrouped { get; set; } = true;
    [Parameter] public bool Multiline { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> OnInput { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> OnChange { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues=true)] public IReadOnlyDictionary<string,object>? AdditionalAttributes { get; set; }

    string InputClass => $"{(IsGrouped && !Multiline ? "core-input-element" : "core-input-standalone")} {CustomClass}";
    string GroupStyle => $"background-color:{AppColors.Background.ToRgbaHex(true)};border-radius:{AppMeasures.Radius.Medium}px;";
    /// <summary>Renders the existing input contract as either one native input or one native multiline editor.</summary>
    /// <returns>Exactly one grouped input or standalone native input/textarea fragment.</returns>
    RenderFragment NativeInput()=>@<text>
        @if(NeedsTooltip(AdditionalAttributes)) { <CoreTooltip Text="@Description(AdditionalAttributes)" Flat="true" Anchor="@DomElement" Id="@DescriptionId" ShowOnFocus="false">@NativeControl()</CoreTooltip> }
        else { @NativeControl() }
    </text>;
    RenderFragment NativeControl() => @<text>
        @if (Multiline) { <textarea @attributes="HtmlAttributes(AdditionalAttributes)" @ref="NativeElement" style="@NativeStyle(AdditionalAttributes)" class="@InputClass" placeholder="@Placeholder" required="@IsRequired" value="@Value" @oninput="HandleInput" @onchange="OnChange"></textarea> }
        else { <input @attributes="HtmlAttributes(AdditionalAttributes)" @ref="NativeElement" style="@NativeStyle(AdditionalAttributes)" type="@Type" class="@InputClass" placeholder="@Placeholder" required="@IsRequired" value="@Value" @oninput="HandleInput" @onchange="OnChange" /> }
    </text>;
    /// <summary>Publishes current text before awaiting the consumer's operation, preserving rapid input ordering.</summary>
    /// <param name="args">The current typed browser input, selection or keyboard event.</param>
    /// <returns>Completion of current-value publication and the supplied consumer callback.</returns>
    async Task HandleInput(ChangeEventArgs args)
    {
        string next = args.Value?.ToString() ?? "";
        if (Value != next) { Value = next; await ValueChanged.InvokeAsync(next); }
        if (OnInput.HasDelegate) await OnInput.InvokeAsync(args);
    }
}
