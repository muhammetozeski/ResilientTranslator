<style>
.core-tooltip-anchor { display:inline-flex; min-width:0; align-items:center; }
.core-tooltip-panel {
    position:fixed; inset:auto; margin:0; padding:@(AppMeasures.Space.Px12)px;
    width:max-content; max-width:min(@(AppMeasures.Tooltip.TextWidth)px, calc(100vw - @(AppMeasures.Tooltip.ViewportInset)px));
    max-height:min(@(AppMeasures.Tooltip.MaximumHeight)px, calc(100vh - @(AppMeasures.Tooltip.ViewportInset)px)); overflow:auto; box-sizing:border-box;
    border:@(AppMeasures.Border.Thin)px solid @AppColors.ControlBorder.ToRgbaHex(true);
    border-radius:@(AppMeasures.Radius.Small)px; background:@AppColors.TooltipBackground.ToRgbaHex(true);
    color:@AppColors.TextPrimary.ToRgbaHex(true); box-shadow:@AppStyles.ShadowMedium;
    font:@(AppMeasures.Font.Small)px/1.5 @AppMeasures.Font.SystemStack;
    white-space:normal; overflow-wrap:break-word; text-align:start; user-select:text;
}
.core-tooltip-panel:popover-open { display:block; }
.core-tooltip-panel::backdrop { background:transparent; pointer-events:none; }
.core-tooltip-panel:not(:popover-open) { display:none; }
.core-tooltip-panel strong { display:block; margin:0 0 @(AppMeasures.Space.Px8)px; font-size:@(AppMeasures.Font.Normal)px; font-weight:@AppMeasures.Weight.Medium; }
.core-tooltip-panel p { margin:@(AppMeasures.Space.Px8)px 0 0; }
.core-tooltip-panel.detector-benchmark-tooltip { max-width:min(@(AppMeasures.Tooltip.TableWidth)px, calc(100vw - @(AppMeasures.Tooltip.ViewportInset)px)); padding:@(AppMeasures.Space.Px12)px; }
</style>
