@if (IsVisible)
{
    <div class="@(Appearance == ControlAppearance.Standard ? "core-modal-backdrop" : "core-modal-overlay") @BackdropClass" @onclick="HandleBackdropClick">
        <div @attributes="AdditionalAttributes" class="@(Appearance == ControlAppearance.Standard ? "core-modal-content" : "core-modal-body") @ContentClass @(IsWobbling ? "wobbling-animation" : "")" style="@ComputedStyle" role="dialog" aria-modal="true" @onkeydown="OnKeyDown" @onclick:stopPropagation>
            @ChildContent
        </div>
    </div>
}
<CoreModalCss />
@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public bool IsWobbling { get; set; }
    [Parameter] public bool IsAcrylic { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnBackdropClick { get; set; }
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }
    [Parameter] public ControlAppearance Appearance { get; set; } = ControlAppearance.Standard;
    [Parameter] public string BackdropClass { get; set; } = "";
    [Parameter] public string ContentClass { get; set; } = "";
    [Parameter(CaptureUnmatchedValues=true)] public IReadOnlyDictionary<string,object>? AdditionalAttributes { get; set; }
    public static Color Background => AppColors.SurfaceStrong;
    public static Color BorderColor => AppColors.GlassBorderDefault;
    public static Color TextColor => AppColors.TextPrimary;
    string? ComputedStyle => Appearance != ControlAppearance.Standard ? null :
        (IsAcrylic ? AppStyles.BuildAcrylicStyle(AcrylicLevel.Strong,AppMeasures.Blur.Heavy) : $"background:{Background.ToRgbaHex(true)};border:{AppMeasures.Border.Thin}px solid {BorderColor.ToRgbaHex(true)};box-shadow:{AppStyles.ShadowHeavy};")
        + $"border-radius:{AppMeasures.Radius.XLarge}px;padding:{AppMeasures.Space.XLarge}px;color:{TextColor.ToRgbaHex(true)};";
    /// <summary>Records the outer-surface action and awaits the caller's existing close operation.</summary>
    async Task HandleBackdropClick()
    {
        Log("CoreModal backdrop tapped, closing modal",Run:true);
        await OnBackdropClick.InvokeAsync();
    }}
