@implements IAsyncDisposable
@implements IHandleEvent
@inject IJSRuntime JavaScript
<CoreTooltipCss />
<span class="core-tooltip-anchor @(Flat ? "core-tooltip-flat" : "") @CustomClass"
    @onpointerenter="PointerEntered" @onpointermove="PointerMoved" @onpointerleave="Leave" @onfocusin="Focused" @onfocusout="Leave" @onkeydown="KeyDown"
    aria-describedby="@(Open?TooltipId:null)" style="@AnchorStyle" @ref="Trigger">
    <CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>
</span>
<CorePopup IsVisible="@Open" Anchor="@Target" Point="@OpeningPoint" Role="tooltip" SurfaceStyle="@($"animation-duration:{Context.TooltipFade}ms")" Id="@TooltipId" SurfaceClass="@($"core-tooltip-panel {PanelClass}")"
    OnDismiss="Hide" OnPointerEnter="Retain" OnPointerLeave="Leave">
    @if(Content is not null){@Content}else{@Text}
</CorePopup>
@code {
    const bool IsLogEnabled=true;
    [CascadingParameter] public PopupScope? Scope {get;set;}
    [Parameter] public RenderFragment? ChildContent {get;set;}
    [Parameter] public RenderFragment? Content {get;set;}
    [Parameter] public string Text {get;set;}="";
    [Parameter] public string CustomClass {get;set;}="";
    [Parameter] public string PanelClass {get;set;}="";
    [Parameter] public ElementHandle? Anchor {get;set;}
    [Parameter] public bool Flat {get;set;}
    [Parameter] public bool ShowOnFocus {get;set;}=true;
    [Parameter] public string? AnchorStyle {get;set;}
    [Parameter] public string Id {get;set;}="tooltip-"+Guid.NewGuid().ToString("N");
    string TooltipId=>Id;
    readonly PopupScope LocalScope=new();
    PopupScope Context=>Scope??LocalScope;
    ElementReference Trigger;
    ElementHandle? TriggerHandle;
    ElementHandle Target=>Anchor??(TriggerHandle??=new(JavaScript,()=>Trigger));
    CancellationTokenSource? Delay;
    bool Open,Disposed;
    // Pointer movement updates the next opening point without rendering on every mouse event.
    Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem callback,object? args)=>callback.InvokeAsync(args);
    PopupPoint? PointerPoint,OpeningPoint;
    Task PointerEntered(PointerEventArgs args){PointerPoint=new(args.ClientX,args.ClientY);return Enter();}
    void PointerMoved(PointerEventArgs args){if(!Open)PointerPoint=new(args.ClientX,args.ClientY);}
    async Task Enter()
    {
        if(!Context.TooltipsEnabled || Disposed || (Content is null&&string.IsNullOrWhiteSpace(Text)))return;
        CancelDelay();if(Open)return;
        CancelDelay();var delay=Delay=new();long version=Context.InteractionVersion;
        try
        {
            await Task.Delay(Context.TooltipDelay,delay.Token);
            if(Disposed||delay.IsCancellationRequested||version!=Context.InteractionVersion||!Context.TooltipsEnabled)return;
            OpeningPoint=PointerPoint;Context.ActivateTooltip(this,Hide);Open=true;Log($"Tooltip opened; id={TooltipId}; rich={Content is not null}",Run:IsLogEnabled);await InvokeAsync(StateHasChanged);
        }
        catch(OperationCanceledException)when(delay.IsCancellationRequested){}
    }
    async Task Leave()
    {
        CancelDelay();var delay=Delay=new();
        try{await Task.Delay(AppMeasures.Tooltip.CloseDelay,delay.Token);if(!Disposed)Hide();}
        catch(OperationCanceledException)when(delay.IsCancellationRequested){}
    }
    void Focused(){if(ShowOnFocus&&Context.KeyboardNavigation){PointerPoint=null;_=InvokeAsync(Enter);}}
    void Retain()=>CancelDelay();
    void KeyDown(KeyboardEventArgs args){if(args.Key=="Escape")Hide();}
    void CancelDelay(){Delay?.Cancel();Delay?.Dispose();Delay=null;}
    void Hide(){CancelDelay();Open=false;Context.ReleaseTooltip(this);if(!Disposed)_=InvokeAsync(StateHasChanged);}
    public async ValueTask DisposeAsync(){Disposed=true;CancelDelay();Context.ReleaseTooltip(this);if(TriggerHandle is not null)await TriggerHandle.DisposeAsync();}
}
