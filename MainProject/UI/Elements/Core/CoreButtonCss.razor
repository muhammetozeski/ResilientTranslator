<style>
    .core-btn{display:inline-flex;align-items:center;justify-content:center;box-sizing:border-box;cursor:pointer;text-align:center}
    .core-btn--standard{transition:transform @(AppMeasures.Duration.Fast)s,box-shadow @(AppMeasures.Duration.Fast)s,opacity @(AppMeasures.Duration.Fast)s;gap:@(AppMeasures.Space.Px8)px}
    .core-btn--compact{font:inherit;border:@(AppMeasures.Border.Thin)px solid @AppColors.ControlBorder.ToRgbaHex(true);border-radius:@(AppMeasures.Radius.Px6)px;background:@AppColors.Control.ToRgbaHex(true);color:@AppColors.TextPrimary.ToRgbaHex(true)}
    .core-btn--compact:hover{background:@AppColors.ControlHover.ToRgbaHex(true)}
    .core-btn--bare{font:inherit}
    .core-btn--bare,.core-btn--compact{display:inline-block}
    .core-btn--full{display:flex;width:@(AppMeasures.Percent.Full)%}
    .core-btn--standard:active:not(:disabled){transform:scale(0.98)}
    .core-btn:disabled{cursor:default;opacity:@AppMeasures.Opacity.Disabled}
</style>
