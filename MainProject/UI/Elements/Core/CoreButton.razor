@inherits CoreElement
@if(NeedsTooltip(AdditionalAttributes))
{
    <CoreTooltip Text="@Description(AdditionalAttributes)" Anchor="@DomElement" Flat="true" Id="@DescriptionId">@Button()</CoreTooltip>
}
else { @Button() }
<CoreButtonCss />
@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool IsFullWidth { get; set; }
    [Parameter] public string CustomClass { get; set; } = "";
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public ControlAppearance Appearance { get; set; } = ControlAppearance.Standard;
    [Parameter] public Color? Background { get; set; }
    [Parameter] public Color? TextColor { get; set; }
    [Parameter] public (Color Start, Color End)? Gradient { get; set; }
    [Parameter] public string BorderRadius { get; set; } = AppMeasures.Radius.Medium + "px";
    [Parameter] public string Padding { get; set; } = AppMeasures.Space.Medium + "px";
    [Parameter] public int FontSize { get; set; } = AppMeasures.Font.Medium;
    [Parameter] public int FontWeight { get; set; } = AppMeasures.Weight.Bold;
    [Parameter] public string Shadow { get; set; } = "none";
    [Parameter] public string Border { get; set; } = "none";
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues=true)] public IReadOnlyDictionary<string,object>? AdditionalAttributes { get; set; }
    const bool IsLogEnabled = true;

    RenderFragment Button()=>@<button @attributes="HtmlAttributes(AdditionalAttributes)" @ref="NativeElement" type="@Type" class="@CssClass" style="@WithPosition(ComputedStyle)" disabled="@Disabled" @onclick="OnClick">@ChildContent</button>;
    string CssClass
    {
        get
        {
            string classes = $"core-btn core-btn--{Appearance.ToString().ToLowerInvariant()}{(IsFullWidth ? " core-btn--full" : "")} {CustomClass}";
            Log($"CoreButton class built (IsFullWidth={IsFullWidth}, CustomClass='{CustomClass}', Appearance={Appearance})",Run:IsLogEnabled);
            return classes;
        }
    }
    string? ComputedStyle => Appearance == ControlAppearance.Standard
        ? $"background:{(Gradient is { } gradient ? $"linear-gradient(135deg,{gradient.Start.ToRgbaHex(true)},{gradient.End.ToRgbaHex(true)})" : Background?.ToRgbaHex(true) ?? "transparent")};color:{TextColor?.ToRgbaHex(true) ?? "inherit"};border-radius:{BorderRadius};padding:{Padding};font-size:{FontSize}px;font-weight:{FontWeight};box-shadow:{Shadow};border:{Border};{Style}"
        : Style;
}
