@inject IJSRuntime JavaScript
@implements IAsyncDisposable
<InfoPopoverCss />
<span class="info-popover @CustomClass" @ref="Trigger">
    <span class="info-popover-trigger" @onclick="Toggle" @onclick:stopPropagation>@ChildContent</span>
</span>
<CorePopup IsVisible="@Open" Anchor="@Target" PreferAbove="true" DismissOnOutside="true" Role="note"
    OnDismiss="Close" SurfaceClass="info-popover-bubble" SurfaceStyle="@BubbleStyle">
    @if(!string.IsNullOrWhiteSpace(Title)){<strong class="info-popover-title">@Title</strong>}
    @if(Content is not null){@Content}else{<span class="info-popover-text">@Text</span>}
</CorePopup>
@code {
    [Parameter] public RenderFragment? ChildContent {get;set;}
    [Parameter] public RenderFragment? Content {get;set;}
    [Parameter] public string Text {get;set;}="";
    [Parameter] public string? Title {get;set;}
    [Parameter] public string CustomClass {get;set;}="";
    ElementReference Trigger;
    ElementHandle? Handle;
    ElementHandle Target=>Handle??=new(JavaScript,()=>Trigger);
    bool Open;
    string BubbleStyle=>$"background:{AppColors.TooltipBackground.ToRgbaHex(true)};border:{AppMeasures.Border.Thin}px solid {AppColors.GlassBorderDefault.ToRgbaHex(true)};box-shadow:{AppStyles.ShadowMedium};";
    void Toggle()=>Open=!Open;
    void Close()=>Open=false;
    public async ValueTask DisposeAsync(){if(Handle is not null)await Handle.DisposeAsync();}
}
