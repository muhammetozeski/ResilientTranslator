@page "/"
@attribute [Route(NavigationConstants.Home.Link)]
@using ResilientTranslator.MainProject.Services
@using ResilientTranslator.MainProject.Infrastructure
@using ResilientTranslator.MainProject.Infrastructure.Localization
@using ResilientTranslator.MainProject.UI.Components
@inherits ResilientTranslator.MainProject.UI.Layout.Architecture.PageBase
<PageTitle>@AppConstants.AppNameHumanReadable</PageTitle>
<HomeCss />
@inject Microsoft.JSInterop.IJSRuntime JavaScript
<StatusTickerCss />
<section class="translator" data-window-background>
    <header class="toolbar" data-window-background inert="@(SettingsOpen ? string.Empty : null)">
        <CoreButton Appearance="ControlAppearance.Bare" CustomClass="brand" data-tooltip="@Strings.HelpBrand" aria-label="@Strings.SettingsTitle" OnClick="OpenSettings"><svg class="brand-icon" viewBox="0 0 256 256" aria-hidden="true"><rect x="10" y="10" width="236" height="236" rx="58" fill="@AppColors.Primary.ToRgbaHex(true)"/><path d="M47 151L81 65H98L132 151H110L103 131H76L69 151ZM82 113H97L90 89Z" fill="@AppColors.BrandInk.ToRgbaHex(true)"/><g fill="none" stroke="@AppColors.BrandInk.ToRgbaHex(true)" stroke-width="12" stroke-linecap="round" stroke-linejoin="round"><path d="M146 84H210M178 68V84M155 86C159 112 179 133 208 146M202 86C194 115 178 133 149 147M57 188H193M179 174L193 188L179 202"/></g></svg><h1>@AppConstants.AppNameHumanReadable</h1></CoreButton>
        <Stack Direction="Stack.Directions.Row" Space="AppMeasures.Size.Px5" Align="Stack.Aligns.Center" Justify="Stack.Justifies.Start" Wrap="false" ItemPaddingTop="0" ItemPaddingRight="0" ItemPaddingBottom="0" ItemPaddingLeft="0" CustomClass="swap-actions"><IconButton Appearance="ControlAppearance.Compact" CustomClass="icon-button" data-tooltip="@Strings.HelpSwapLanguages" aria-label="@Strings.SwapLanguages" OnClick="TranslationWorkspace.SwapLanguagesAsync" Size="AppMeasures.Size.Px32"><svg viewBox="0 0 28 28" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 15L7 5L11 15M4.5 12H9.5M16 7H25M20.5 4V7M18 8C19 11 21 13 25 15M24 8C23 11 21 13 17 15M4 21H23M20 18L23 21L20 24M7 18L4 21L7 24"/></g></svg></IconButton>
<IconButton Appearance="ControlAppearance.Compact" CustomClass="icon-button" data-tooltip="@Strings.HelpSwapTexts" aria-label="@Strings.SwapTexts" OnClick="TranslationWorkspace.SwapTexts" Size="AppMeasures.Size.Px32"><svg viewBox="0 0 28 28" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4H11M3 8H9M3 12H10M17 4H25M17 8H23M17 12H24M4 21H23M20 18L23 21L20 24M7 18L4 21L7 24"/></g></svg></IconButton></Stack>
        <div class="language-pair" data-window-background>
            <CoreSelect data-tooltip="@FeatureText.Get("SourceTooltip")" aria-label="@Strings.SourceLanguage" value="@TranslationWorkspace.SourceLanguage" OnChange="SourceChanged">@LanguageOptions()</CoreSelect>
            <CoreButton Appearance="ControlAppearance.Bare" CustomClass="send" data-tooltip="@Strings.HelpTranslateNow" aria-label="@Strings.TranslateNow" data-native-command="translate" OnClick="TranslateNow">→</CoreButton>
            <CoreSelect data-tooltip="@FeatureText.Get("TargetTooltip")" aria-label="@Strings.TargetLanguage" value="@TranslationWorkspace.TargetLanguage" OnChange="TargetChanged">@LanguageOptions()</CoreSelect>
        </div>
        <StatusTicker Text="@TranslationWorkspace.Status" State="@LightState" OnToggle="TranslationWorkspace.ToggleOnlineAsync" LightTooltip="@ModeTooltip" Speed="@Preferences.StatusSpeed" />
        <CoreButton Appearance="ControlAppearance.Bare" CustomClass="hide" data-tooltip="@Strings.HelpHide" aria-label="@Strings.Hide" data-native-command="hide" OnClick="Hide">−</CoreButton>
    </header>
    <div class="editors" data-window-background inert="@(SettingsOpen ? string.Empty : null)" style="@AppStyles.BuildEditorTypography(Preferences.EditorFontFamily,Preferences.EditorFontSize)">
        <CoreInput Multiline="true" IsGrouped="false" @ref="InputElement" id="input" data-tooltip="@FeatureText.Get("InputTooltip")" aria-label="@Strings.InputLabel" spellcheck="false" Value="@TranslationWorkspace.Input" OnInput="InputChanged" />
        <EditorSplitter />
        <CoreInput Multiline="true" IsGrouped="false" id="output" data-tooltip="@FeatureText.Get("OutputTooltip")" aria-label="@Strings.OutputLabel" spellcheck="false" Value="@TranslationWorkspace.Output" OnInput="OutputChanged" />
    </div>
    <CoreTooltip Text="@FeatureText.Get("ResizeTooltip")" Anchor="@ResizeHandle" Flat="true"><div @ref="ResizeElement" class="resize-grip" data-tooltip="@FeatureText.Get("ResizeTooltip")" data-window-resize aria-hidden="true"></div></CoreTooltip>
    @if (SettingsOpen) { <SettingsPanel OnClose="CloseSettings" /> }
</section>
@code {
    CoreInput? InputElement;
    bool SettingsOpen;
    [CascadingParameter] public PopupScope? PopupContext {get;set;}
    ElementReference ResizeElement;
    ElementHandle? ResizeBinding;
    ElementHandle ResizeHandle=>ResizeBinding??=new(JavaScript,()=>ResizeElement);
    readonly CancellationTokenSource Warmup=new();
    string LightState=>!Settings.OnlineEnabled.Value ? "offline" : TranslationWorkspace.HasError?"error":TranslationWorkspace.IsBusy?"busy":"ready";
    string ModeTooltip=>FeatureText.Get(LightState=="offline"?"OfflineTooltip":"OnlineTooltip");

    /// <summary>Connects the retained screen to editor state, preferences and native opening focus.</summary>
    protected override void OnInitialized()
    {
        base.OnInitialized();
        ApplyTooltipSettings();
        TranslationWorkspace.Changed += Refresh;
        Preferences.Changed += Refresh;
        TranslationWorkspace.WindowHidden += DismissSettings;
        TranslationWorkspace.FocusInput = FocusInputAsync;
    }
    /// <summary>Focuses the first real editor after native activation; opening settings retains its own focus.</summary>
    /// <param name="token">Cancels the pending UI dispatch or input-focus wait.</param>
    /// <returns>Completion of focus transfer into the existing first editor.</returns>
    Task FocusInputAsync(CancellationToken token) => InvokeAsync(async () =>
    {
        token.ThrowIfCancellationRequested();
        if (!SettingsOpen) await (InputElement ?? throw new InvalidOperationException("The input component is unavailable.")).FocusAsync(preventScroll: true).AsTask().WaitAsync(token);
    });
    /// <summary>Signals native readiness only after the first complete Blazor render.</summary>
    /// <param name="firstRender">Whether this is the first completed render of this component instance.</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(!firstRender)return;
        TranslationWorkspace.ViewReady?.Invoke();
        await ExceptionBoundary.RunSafelyAsync(async token=>
        {
            await TranslationRuntime.InitializeAsync(JavaScript);
            _=ExceptionBoundary.RunSafelyAsync(ct=>TranslationRuntime.WarmAsync(ct),Warmup.Token,operationName:"WarmLocalEngines");
        },operationName:"InitializeLocalEngines");
    }
    /// <summary>Renders shared-state notifications on the owning dispatcher.</summary>
    void ApplyTooltipSettings()=>PopupContext?.ConfigureTooltips(Settings.EnableTooltips.Value,(int)Math.Round(Settings.TooltipDelay.Value*1000),(int)Math.Round(Settings.TooltipFade.Value*1000));
    void Refresh() => _ = ExceptionBoundary.RunSafelyAsync(async token => await InvokeAsync(()=>{ApplyTooltipSettings();StateHasChanged();}).WaitAsync(token),operationName:"RefreshHome");
    /// <summary>Opens the preferences dialog from the product icon or title.</summary>
    void OpenSettings() => SettingsOpen = true;
    /// <summary>Closes settings without discarding already persisted edits.</summary>
    void CloseSettings() => SettingsOpen = false;
    /// <summary>Discards only the open dialog when outside-window dismissal hides the retained surface.</summary>
    void DismissSettings() => _ = ExceptionBoundary.RunSafelyAsync(async token => await InvokeAsync(() => { SettingsOpen = false; PopupContext?.Resize(); StateHasChanged(); }).WaitAsync(token),operationName:"DismissSettings");
    /// <summary>Uses the same immediate hide action when a native browser bridge is unavailable.</summary>
    void Hide() => TranslationWorkspace.HideWindow?.Invoke();
    /// <summary>Starts a fresh forward translation without debounce or cache reuse.</summary>
    /// <returns>Completion of the fresh forward translation without debounce or confirmed-cache reuse.</returns>
    Task TranslateNow() => TranslationWorkspace.EditAsync(TranslationWorkspace.Input, true, true, forceNetwork: true);
    /// <summary>Accepts input edits through the latest-request translation pipeline.</summary>
    /// <param name="args">The current typed browser input, selection or keyboard event.</param>
    /// <returns>Completion or cancellation of this newest forward editor command.</returns>
    Task InputChanged(ChangeEventArgs args) => TranslationWorkspace.EditAsync(args.Value?.ToString() ?? "", true);
    /// <summary>Accepts reverse edits through the same translation pipeline.</summary>
    /// <param name="args">The current typed browser input, selection or keyboard event.</param>
    /// <returns>Completion or cancellation of this newest reverse editor command.</returns>
    Task OutputChanged(ChangeEventArgs args) => TranslationWorkspace.EditAsync(args.Value?.ToString() ?? "", false);
    /// <summary>Applies source selection and the existing language collision rules.</summary>
    /// <param name="args">The current typed browser input, selection or keyboard event.</param>
    /// <returns>Completion of normalized source selection and its resulting translation.</returns>
    Task SourceChanged(ChangeEventArgs args) => TranslationWorkspace.SetLanguagesAsync(args.Value?.ToString() ?? "en", TranslationWorkspace.TargetLanguage);
    /// <summary>Applies target selection and the existing Automatic fallback rules.</summary>
    /// <param name="args">The current typed browser input, selection or keyboard event.</param>
    /// <returns>Completion of normalized target selection and its resulting translation.</returns>
    Task TargetChanged(ChangeEventArgs args) => TranslationWorkspace.SetLanguagesAsync(TranslationWorkspace.SourceLanguage, args.Value?.ToString() ?? "tr");
    /// <summary>Uses the language catalog shared with startup preferences.</summary>
    /// <returns>The shared language-option fragment used by both native selectors.</returns>
    RenderFragment LanguageOptions() => @<text>@foreach (var language in LanguageCatalog.All) { <option value="@language.Code">@language.Name</option> }</text>;
    /// <summary>Releases retained screen subscriptions when its component is disposed.</summary>
    public override void Dispose()
    {
        Warmup.Cancel();Warmup.Dispose();
        TranslationWorkspace.Changed -= Refresh;
        Preferences.Changed -= Refresh;
        TranslationWorkspace.WindowHidden -= DismissSettings;
        if (TranslationWorkspace.FocusInput == FocusInputAsync) TranslationWorkspace.FocusInput = null;
        if(ResizeBinding is not null)_=ExceptionBoundary.RunSafelyAsync(async _=>await ResizeBinding.DisposeAsync(),operationName:"DisposeResizeElement");
        base.Dispose();
    }
}