<style>
    .translator{height:100dvh;position:relative;display:grid;grid-template-rows:@(AppMeasures.Size.Px36)px minmax(0,1fr);gap:@(AppMeasures.Size.Px8)px;background:@AppColors.BackgroundDeep.ToRgbaHex(true);color:@AppColors.TextPrimary.ToRgbaHex(true);font-family:@AppMeasures.Font.SystemStack;padding:@(AppMeasures.Size.Px10)px @(AppMeasures.Size.Px12)px @(AppMeasures.Size.Px12)px;box-sizing:border-box;border:@(AppMeasures.Size.Px1)px solid @AppColors.WindowBorder.ToRgbaHex(true);border-radius:@(AppMeasures.Size.Px3)px;overflow:hidden}
    .translator *{box-sizing:border-box}.translator select,.translator input{font:inherit}.translator button{cursor:pointer}.translator select{border:@(AppMeasures.Size.Px1)px solid @AppColors.ControlBorder.ToRgbaHex(true);border-radius:@(AppMeasures.Size.Px6)px;background:@AppColors.Control.ToRgbaHex(true);color:@AppColors.TextPrimary.ToRgbaHex(true)}
    .translator button:hover{background:@AppColors.ControlHover.ToRgbaHex(true)}.translator button:focus-visible,.translator select:focus-visible,.translator input:focus-visible{outline:@(AppMeasures.Size.Px2)px solid @AppColors.Primary.ToRgbaHex(true);outline-offset:@(AppMeasures.Size.Px1)px}
    .toolbar,.brand,.swap-actions,.language-pair{display:flex;align-items:center;min-width:0}.toolbar{gap:@(AppMeasures.Size.Px10)px}.toolbar>.status-ticker{flex:1}
    .translator .brand{display:flex;gap:@(AppMeasures.Size.Px9)px;flex-shrink:0;white-space:nowrap;background:transparent;border:0;padding:0;color:@AppColors.TextPrimary.ToRgbaHex(true)}.brand-icon{width:@(AppMeasures.Size.Px32)px;height:@(AppMeasures.Size.Px32)px;flex-shrink:0}h1{font-size:@(AppMeasures.Size.Px18)px;font-weight:600;letter-spacing:@(AppMeasures.Tracking.Compact)px;margin:0}
    .swap-actions{gap:@(AppMeasures.Size.Px5)px;flex-shrink:0}.translator .icon-button{display:grid;place-items:center;width:@(AppMeasures.Size.Px32)px;height:@(AppMeasures.Size.Px32)px;padding:@(AppMeasures.Size.Px4)px;background:@AppColors.IconSurface.ToRgbaHex(true);border-color:@AppColors.IconBorder.ToRgbaHex(true);color:@AppColors.IconText.ToRgbaHex(true)}.icon-button svg{width:@(AppMeasures.Size.Px23)px;height:@(AppMeasures.Size.Px23)px}
    .language-pair{gap:@(AppMeasures.Size.Px7)px;flex-shrink:0}.translator select{field-sizing:content;width:auto;min-width:0;height:@(AppMeasures.Size.Px32)px;padding:@(AppMeasures.Size.Px3)px @(AppMeasures.Size.Px7)px;font-size:@(AppMeasures.Size.Px13)px}.translator .send,.translator .hide{background:transparent;border:0;flex-shrink:0;padding:0;width:@(AppMeasures.Size.Px25)px;height:@(AppMeasures.Size.Px32)px;color:@AppColors.CommandText.ToRgbaHex(true);font-size:@(AppMeasures.Size.Px20)px}.translator .hide{margin-left:auto;font-size:@(AppMeasures.Size.Px24)px;width:@(AppMeasures.Size.Px28)px}
    .editors{display:grid;grid-template-columns:minmax(0,var(--input-share,50fr)) @(AppMeasures.Size.Px8)px minmax(0,var(--output-share,50fr));gap:0;min-height:0}.editor-pane{position:relative;min-width:0;min-height:0}.editors textarea{display:block;width:@(AppMeasures.Percent.Full)%;height:@(AppMeasures.Percent.Full)%;min-height:0;resize:none;background:@AppColors.SurfaceNormal.ToRgbaHex(true);color:inherit;border:@(AppMeasures.Size.Px1)px solid @AppColors.EditorBorder.ToRgbaHex(true);border-radius:@(AppMeasures.Size.Px8)px;padding:@(AppMeasures.Size.Px11)px @(AppMeasures.Size.Px12)px;font:inherit;line-height:@AppMeasures.LineHeight.Editor;outline:none;scrollbar-width:thin;scrollbar-color:#4b5866 transparent}.editors .output-pane textarea{border-color:@AppColors.OutputBorder.ToRgbaHex(true)}.editors textarea:focus{border-color:@AppColors.FocusBorder.ToRgbaHex(true)}
    .resize-grip{position:absolute;right:0;bottom:0;width:@(AppMeasures.Size.Px14)px;height:@(AppMeasures.Size.Px14)px;cursor:nwse-resize;touch-action:none;background:repeating-linear-gradient(135deg,transparent 0 @(AppMeasures.Size.Px3)px,#7a9687 @(AppMeasures.Size.Px3)px @(AppMeasures.Size.Px4)px,transparent @(AppMeasures.Size.Px4)px @(AppMeasures.Size.Px6)px);clip-path:polygon(@(AppMeasures.Percent.Full)% 0,@(AppMeasures.Percent.Full)% @(AppMeasures.Percent.Full)%,0 @(AppMeasures.Percent.Full)%)}
    @@media(max-width:@(AppMeasures.Breakpoints.CompactToolbar)px){.brand h1{display:none}.toolbar{gap:@(AppMeasures.Size.Px7)px}}
    @@media(max-width:@(AppMeasures.Breakpoints.NarrowToolbar)px){.translator{padding:@(AppMeasures.Size.Px8)px @(AppMeasures.Size.Px8)px @(AppMeasures.Size.Px12)px}.toolbar{gap:@(AppMeasures.Size.Px5)px}.language-pair{gap:@(AppMeasures.Size.Px3)px}.translator select{padding-left:@(AppMeasures.Size.Px4)px;padding-right:@(AppMeasures.Size.Px3)px}.translator .send{width:@(AppMeasures.Size.Px18)px}}
</style>

