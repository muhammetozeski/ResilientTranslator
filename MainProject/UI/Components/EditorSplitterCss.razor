<style>
    .editor-splitter{align-self:stretch;width:8px;cursor:col-resize;touch-action:none;position:relative;outline:none}
    .editor-splitter::after{content:"";position:absolute;left:3px;top:8px;bottom:8px;width:2px;border-radius:2px;background:transparent}
    .editor-splitter:hover::after,.editor-splitter:focus-visible::after,.editor-splitter.dragging::after{background:var(--accent)}
    .editor-splitter.snapped::after{width:3px;left:2px}
</style>
