<style>
    .editor-splitter{align-self:stretch;width:@(AppMeasures.Size.Px8)px;cursor:col-resize;touch-action:none;position:relative;outline:none}
    .editor-splitter::after{content:"";position:absolute;left:@(AppMeasures.Size.Px3)px;top:@(AppMeasures.Size.Px8)px;bottom:@(AppMeasures.Size.Px8)px;width:@(AppMeasures.Size.Px2)px;border-radius:@(AppMeasures.Size.Px2)px;background:transparent}
    .editor-splitter:hover::after,.editor-splitter:focus-visible::after,.editor-splitter.dragging::after{background:@AppColors.Primary.ToRgbaHex(true)}
    .editor-splitter.snapped::after{width:@(AppMeasures.Size.Px3)px;left:@(AppMeasures.Size.Px2)px}
</style>
