<style>
    .settings-backdrop{position:absolute;inset:0;background:#0007;display:grid;place-items:center;padding:16px}
    .settings-panel{background:var(--surface);border:1px solid var(--control-border);border-radius:10px;width:min(680px,100%);max-height:100%;overflow:auto;box-shadow:0 12px 40px #0007}
    .settings-panel>header{display:flex;align-items:center;justify-content:space-between;padding:13px 16px;border-bottom:1px solid var(--control-border)}.settings-panel h2{font-size:18px;margin:0}.settings-panel>header button{height:30px;width:30px;font-size:22px}
    .settings-fields{display:flex;flex-direction:column;gap:13px;padding:16px}.settings-fields label{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:14px}.settings-fields label>span{flex:1}.settings-fields input[type=number]{width:100px;background:var(--control);color:var(--text);border:1px solid var(--control-border);border-radius:5px;padding:6px}.settings-fields input[type=range]{flex:1;min-width:80px;accent-color:var(--accent)}.settings-fields output{width:70px;text-align:right;font-size:12px;white-space:nowrap}.settings-fields button{padding:5px 9px;font-size:13px}
    .number-stepper,.color-controls{display:flex;align-items:center;gap:6px}.number-stepper input{text-align:center}.number-stepper button{width:29px;height:31px}.color-controls input{height:31px;width:43px;background:var(--control);border:1px solid var(--control-border);padding:2px;border-radius:5px;cursor:pointer}.font-picker>select{width:100%;height:auto;field-sizing:fixed;margin-top:8px}.technical-settings{display:flex;flex-direction:column;gap:11px;margin-top:13px}.technical-settings input[type=checkbox]{accent-color:var(--accent)}.settings-fields summary{cursor:pointer;color:var(--muted-text);font-size:14px}.settings-error{color:var(--failure);font-size:13px;margin:0}
</style>
