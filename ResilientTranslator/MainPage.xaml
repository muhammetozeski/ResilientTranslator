<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ResilientTranslator"
             xmlns:shared="clr-namespace:ResilientTranslator.MainProject.UI;assembly=MainProject"
             x:Class="ResilientTranslator.MainPage"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <BlazorWebView BlazorWebViewInitialized="OnWebViewInitialized" x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type shared:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
