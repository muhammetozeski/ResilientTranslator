  {
    "id": "tr-extra-20",
    "source": "tr",
    "category": "sentence",
    "text": "Metni buraya yapıştır."
  },
  {
    "id": "tr-extra-21",
    "source": "tr",
    "category": "sentence",
    "text": "Neden hâlâ cevap gelmedi?"
  },
  {
    "id": "tr-extra-22",
    "source": "tr",
    "category": "sentence",
    "text": "İşlem tamamlanınca bana haber ver."
  },
  {
    "id": "tr-extra-23",
    "source": "tr",
    "category": "sentence",
    "text": "Bu dosyayı başka bir klasöre taşı."
  },
  {
    "id": "tr-extra-24",
    "source": "tr",
    "category": "sentence",
    "text": "Bugün dışarı çıkmak istemiyorum."
  },
  {
    "id": "tr-extra-25",
    "source": "tr",
    "category": "sentence",
    "text": "Bunu daha önce nerede gördüğümü hatırlamıyorum."
  },
  {
    "id": "tr-extra-26",
    "source": "tr",
    "category": "sentence",
    "text": "Çeviri yaparken pencere donmasın."
  },
  {
    "id": "tr-extra-27",
    "source": "tr",
    "category": "sentence",
    "text": "Yazdıklarım kaybolmuş olabilir."
  },
  {
    "id": "tr-extra-28",
    "source": "tr",
    "category": "sentence",
    "text": "Yarın sabah erkenden yola çıkacağız."
  },
  {
    "id": "tr-extra-29",
    "source": "tr",
    "category": "sentence",
    "text": "Bana bunun nasıl çalıştığını anlatır mısın?"
  },
  {
    "id": "tr-extra-30",
    "source": "tr",
    "category": "sentence",
    "text": "İnternetim yok ama çeviri yapmak istiyorum."
  },
  {
    "id": "tr-extra-31",
    "source": "tr",
    "category": "sentence",
    "text": "Önceki çeviri hâlâ devam ediyor."
  },
  {
    "id": "tr-extra-32",
    "source": "tr",
    "category": "sentence",
    "text": "Sağdaki kutuya tıklamadan yazabilmeliyim."
  },
  {
    "id": "tr-extra-33",
    "source": "tr",
    "category": "sentence",
    "text": "Bu iş sandığımdan daha uzun sürdü."
  },
  {
    "id": "tr-extra-34",
    "source": "tr",
    "category": "sentence",
    "text": "Keşke dosyayı silmeden önce bir kopyasını alsaydım."
  },
  {
    "id": "tr-extra-35",
    "source": "tr",
    "category": "sentence",
    "text": "Yalnızca en son istediğim metni çevir."
  },
  {
    "id": "tr-extra-36",
    "source": "tr",
    "category": "sentence",
    "text": "Pencere küçülünce yazılar birbirine girmesin."
  },
  {
    "id": "tr-extra-37",
    "source": "tr",
    "category": "sentence",
    "text": "Teşekkür ederim, şimdi çok daha iyi oldu."
  },
  {
    "id": "tr-extra-38",
    "source": "tr",
    "category": "sentence",
    "text": "Şu anda bilgisayarımda hiçbir şey indirmiyorum."
  },
  {
    "id": "tr-extra-39",
    "source": "tr",
    "category": "sentence",
    "text": "Dün gece yarısına kadar bununla uğraştım."
  },
