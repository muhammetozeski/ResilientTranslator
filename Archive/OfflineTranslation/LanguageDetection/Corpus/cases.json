  },
  {
    "id": "en-text-1",
    "source": "en",
    "category": "phrase",
    "text": "Please do not close this window"
  },
  {
    "id": "en-text-2",
    "source": "en",
    "category": "phrase",
    "text": "We can finish this tomorrow"
  },
  {
    "id": "en-text-3",
    "source": "en",
    "category": "sentence",
    "text": "Cancel the previous operation when a new request arrives."
  },
  {
    "id": "en-text-4",
    "source": "en",
    "category": "sentence",
    "text": "My settings should be preserved even if the connection drops."
  },
  {
