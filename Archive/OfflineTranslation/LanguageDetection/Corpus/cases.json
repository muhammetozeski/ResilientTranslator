  },
  {
    "id": "tr-text-0",
    "source": "tr",
    "category": "phrase",
    "text": "Dosyayı kaydet"
  },
  {
    "id": "tr-text-1",
    "source": "tr",
    "category": "phrase",
    "text": "Pencereyi kapatma"
  },
  {
    "id": "tr-text-2",
    "source": "tr",
    "category": "phrase",
    "text": "Bunu yarın yapabiliriz"
  },
  {
    "id": "tr-text-3",
    "source": "tr",
    "category": "sentence",
    "text": "Yeni bir istek geldiğinde önceki işlemi iptal et."
  },
  {
    "id": "tr-text-4",
    "source": "tr",
    "category": "sentence",
    "text": "İnternet bağlantısı kesilse bile ayarlarım korunmalı."
  },
  {
